# ---- Server ----

# TCP port the HTTP server listens on. Defaults to 1323 when empty.
PORT=1323

# Log verbosity: debug | info | warn | error. Unknown values fall back to info.
LOG_LEVEL=info

# ---- Auth ----

# HMAC secret used to sign and verify JWTs. When empty a random secret is
# generated at startup, which invalidates every issued token on restart.
# Set an explicit value in any environment that matters.
JWT_SECRET=

# ---- Email ----

# Origin prepended to the verification link in outgoing email.
# Defaults to http://localhost:1323 when empty. Must be the public URL of
# this server in production, or verification links will be unreachable.
APP_BASE_URL=http://localhost:1323

# Resend API key used to deliver verification email. When empty the server
# uses LogMailer instead, which only writes the verification link to the logs
# (suitable for local development).
RESEND_API_KEY=

# Sender address for verification email. Must be on a domain verified in your
# Resend account. Defaults to onboarding@resend.dev (Resend's sandbox sender).
RESEND_FROM_EMAIL=onboarding@resend.dev

# ---- Storage (Firestore) ----

# GCP project ID hosting the Firestore database used to persist employees.
# Required: the server exits at startup when this is empty.
FIRESTORE_PROJECT_ID=

# Firestore database ID within the project (this is the database name, not a
# collection prefix). Use "(default)" for the project's default database.
FIRESTORE_DATABASE_NAME=(default)

# Path to a Google service-account JSON key file. Read by the Google SDK, not
# by this app. On GCE/GKE/Cloud Run the platform identity is picked up
# automatically and this can stay empty. For local dev either point it at a
# downloaded key file, or run `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=
