# Copy to .env and fill in real values. .env is git-ignored and should never
# contain real secrets in source control.

# Secret used to sign JWT access tokens. Set to a long random string in any
# non-throwaway environment. If unset, the server falls back to a random
# secret per restart (dev only).
JWT_SECRET=change-me-to-a-long-random-string

# Port the HTTP server listens on. Defaults to 1323.
PORT=1323