# 360°Review environment configuration.
# Copy this file to ".env" and fill in real values. ".env" is gitignored.

# ---- Server ----
# Port the HTTP server listens on. Defaults to 1323.
PORT=1323

# ---- Logging ----
# slog level: debug, info, warn, error. Defaults to info.
LOG_LEVEL=info

# ---- Auth ----
# Secret used to sign JWTs (HS256). REQUIRED in production: set a long random
# string. If left empty, a random secret is generated per restart, which means
# issued tokens (and email-verification tokens) will not survive a restart.
JWT_SECRET=

# ---- App URL ----
# Public origin of the app, used to build the email-verification link sent to
# users (e.g. https://review.example.com). Defaults to http://localhost:1323.
APP_BASE_URL=http://localhost:1323

# ---- Email (Resend) ----
# When set, verification email is delivered via the Resend API. When empty,
# a LogMailer is used and the verification link is only written to the logs
# (suitable for local development).
RESEND_API_KEY=
# Sender address for verification email. Must be on a domain verified in your
# Resend account. Defaults to onboarding@resend.dev (Resend's sandbox sender).
RESEND_FROM_EMAIL=onboarding@resend.dev